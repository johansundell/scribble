# true logs the route table and an access log line per request
DEBUG=false
PORT=:8080
# true serves assets/ and tmpl/ from next to the binary; needs a built binary, not go run
USE_FILE_SYSTEM=false
TIMEOUT=15
# storage backend: sqlite, mysql or filemaker
STORAGE=sqlite
# optional path to sqlite database file (defaults to <binary dir>/<nameOfService>.db)
SQLITE_PATH=""
# opens /totp-setup; also a static API token, deprecated now that apps log
# in with an authenticator code (sn login, ADR 14). Leave empty to generate a
# temporary token on each start
AUTH_TOKEN=""
# web app at /: base32 secret for authenticator app (TOTP) login codes, at
# least 26 characters: head -c 20 /dev/urandom | base32. Empty turns the web
# app off. Add it to an app at /totp-setup with AUTH_TOKEN. With
# STORAGE=sqlite, sn and the desktop app log in with its codes too.
WEB_TOTP_SECRET=""
# signs the web session cookie; at least 32 characters: openssl rand -base64 33
SESSION_SECRET=""
WEB_SESSION_TIMEOUT="168h"
# optional plain text under the login code field, e.g. how to log in to a demo
WEB_LOGIN_HINT=""
# true only on a public demo: the login screen shows the authenticator secret
# (QR code and text) to everyone, and wrong codes never lock web login for
# everyone (the per-address limit stays)
PUBLIC_DEMO=false
# proxies whose X-Forwarded-For is believed, e.g. 127.0.0.1 for nginx on this host
TRUSTED_PROXIES=""
# false only for local testing over plain HTTP
COOKIE_SECURE=true
MYSQL_USERNAME=""
MYSQL_PASSWORD=""
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="test"
# FileMaker (STORAGE=filemaker); the log table must exist, see README,
# unless FMS_CREATE_LOG_TABLE=true lets startup create it (needs schema privileges)
FMS_HOST="https://fms.example.com"
FMS_DATABASE=""
FMS_USERNAME=""
FMS_PASSWORD=""
FMS_TIMEOUT="10s"
FMS_LOG_TABLE="Logs"
FMS_CREATE_LOG_TABLE=false
# optional PEM file with a private CA; FMS_INSECURE_SKIP_VERIFY disables checks
FMS_CA_FILE=""
FMS_INSECURE_SKIP_VERIFY=false
# FileMaker replica of the notes (NOTES_REPLICA=filemaker); its tables must
# exist, see docs/filemaker/notes.md, unless FMS_CREATE_REPLICA_TABLES=true
# lets the sync create the missing ones (needs schema privileges)
FMS_CREATE_REPLICA_TABLES=false
