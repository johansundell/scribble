  <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="0" name="Scribble UI Show List">
    <Step enable="True" id="89" name="# (comment)"><Text>The live notes, newest first. Run by "Back" buttons and after a save or delete; also a good start-up script.</Text></Step>
    <Step enable="True" id="86" name="Set Error Capture"><Set state="True" /></Step>
    <Step enable="True" id="75" name="Commit Records/Requests"><NoInteract state="True" /><Option state="False" /><ESSForceCommit state="False" /></Step>
    <Step enable="True" id="6" name="Go to Layout"><LayoutDestination value="SelectedLayout" /><Layout id="0" name="Scribble_List" /></Step>
    <Step enable="True" id="22" name="Enter Find Mode"><Pause state="False" /><Restore state="False" /></Step>
    <Step enable="True" id="76" name="Set Field"><Calculation><![CDATA[0]]></Calculation><Field table="Notes" id="0" name="Deleted" /></Step>
    <Step enable="True" id="28" name="Perform Find"><Restore state="False" /></Step>
    <Step enable="True" id="154" name="Sort Records by Field"><SortRecordsByField value="SortDescending" /><Field table="Notes" id="0" name="UpdatedAt" /></Step>
  </Script>
  <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="0" name="Scribble UI New">
